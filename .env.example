# ---- runtime mode ----
# local | aws
HR_MODE=local
HR_LOG_LEVEL=INFO
# ---- control plane (Postgres + pgvector) ----
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness
# ---- acceleration ----
REDIS_URL=redis://localhost:6379/0
# ---- identity ----
# local (HS256 dev secret) | cognito (JWKS)
HR_JWT_MODE=local
HR_JWT_SECRET=dev-only-change-me
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1
COGNITO_APP_CLIENT_ID=
# ---- policy ----
# cedar_local | verified_permissions
HR_AUTHZ_BACKEND=cedar_local
AVP_POLICY_STORE_ID=
# ---- models (gateway) ----
# fake (deterministic offline stub, reported as offline-stub) | bedrock
HR_MODEL_BACKEND=fake
AWS_REGION=us-east-1
# Inference profile ids (the bare model ids cannot be invoked on demand)
BEDROCK_GENERATION_MODEL=us.anthropic.claude-sonnet-5-5
BEDROCK_VERIFIER_MODEL=us.anthropic.claude-haiku-5-5
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0
# fastembed | bedrock
HR_EMBED_BACKEND=fastembed
# fastembed | bedrock
HR_RERANK_BACKEND=fastembed
# ---- ingestion (SEC requires app name + contact email in the User-Agent) ----
EDGAR_USER_AGENT=multi-agent-finance-example you@example.com
# ---- durable ingestion ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
S3_RAW_BUCKET=
# ---- telemetry ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=multi-agent-finance-api
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# ---- budgets ----
HR_TURN_TOKEN_BUDGET=40000
# optional override of the reranker's own relevance floor (BGE logits vs Cohere 0..1)
# HR_RERANK_MIN_SCORE=
HR_TURN_TOOL_CALL_BUDGET=8
HR_TURN_TIMEOUT_SECONDS=60
# ---- guardrails ----
# empty = Bedrock Guardrails off; deterministic checks always run
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
HR_RATE_LIMIT_PER_MINUTE=30
